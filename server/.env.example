PORT=3000

# Gestionar (logística — fullfilment, CABA/GBA)
GESTIONAR_API_KEY=
# Opcional: override del base URL (default https://apiv1.gestionarlogistica.com.ar)
# GESTIONAR_API_URL=https://apiv1.gestionarlogistica.com.ar
# Tarifa fija de envío a domicilio CABA/GBA en ARS. Si está vacío, Gestionar
# queda DESHABILITADO y todos los envíos los toma Correo Argentino.
GESTIONAR_FLAT_RATE_HOME=
# Opcional: texto de ETA mostrado en el checkout (default "1 a 3 días hábiles")
# GESTIONAR_ETA_HOME=1 a 3 días hábiles
# Habilita el cron in-process que sube las órdenes paid a Gestionar.
# 'true' para activar; cualquier otra cosa o vacío = desactivado.
GESTIONAR_BATCH_ENABLED=
# Cron schedule (default cada 15 min). Sintaxis estándar de node-cron.
# GESTIONAR_BATCH_CRON=*/15 * * * *

# Supabase (service role + anon para verificar JWT en rutas admin)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Resend (emails de pedidos)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: para testear, enviar TODO a este email
RESEND_TEST_TO_EMAIL=

# Nave (pagos)
# Entorno: testing o production
NAVE_ENV=testing
NAVE_CLIENT_ID=
NAVE_CLIENT_SECRET=
# Requerido por documentación Nave M2M (ej. https://naranja.com/ranty/merchants/api)
NAVE_AUDIENCE=
NAVE_CACHE=
# POS ID proporcionado por Nave/Galicia
NAVE_POS_ID=
# Opcional: duration_time al crear la intención (Nave: segundos). Default en código: 600 (10 min).
# Para no enviar el campo (default del servidor Nave): NAVE_PAYMENT_DURATION_SECS=omit
# NAVE_PAYMENT_DURATION_SECS=

# Mercado Pago (Orders API + webhooks)
# Access token: Tus integraciones → Pruebas → Credenciales de prueba
MP_ACCESS_TOKEN=
# Clave secreta de notificaciones (Webhooks en el panel de la app)
MP_WEBHOOK_SECRET=

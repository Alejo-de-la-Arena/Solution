PORT=3000

# Gestionar (logística — fullfilment, CABA/GBA)
GESTIONAR_API_KEY=
# Opcional: override del base URL (default https://apiv1.gestionarlogistica.com.ar)
# GESTIONAR_API_URL=https://apiv1.gestionarlogistica.com.ar
# Switch de Gestionar: cualquier valor (ej: 1) habilita Gestionar para CABA/GBA;
# vacío deshabilita y todo el país cae en Correo Argentino. El precio que se
# cobra al cliente espeja la tarifa Clásico Domicilio (D-CP) de Correo
# Argentino — el valor numérico de esta env ya no se usa como tarifa.
GESTIONAR_FLAT_RATE_HOME=
# Opcional: texto de ETA mostrado en el checkout (default "1 a 3 días hábiles")
# GESTIONAR_ETA_HOME=1 a 3 días hábiles
# Habilita el cron in-process que sube las órdenes paid a Gestionar.
# 'true' para activar; cualquier otra cosa o vacío = desactivado.
GESTIONAR_BATCH_ENABLED=
# SKU del perfumero de regalo que Gestionar despacha por cada combo (2 perfumes).
# El dispatcher suma una línea con este SKU al fulfillment de las órdenes con
# combo. Default: PER-S-SOL-UTI. Override solo si cambia el código en Gestionar.
# GESTIONAR_COMBO_GIFT_SKU=PER-S-SOL-UTI
# Cron schedule (default cada 15 min). Sintaxis estándar de node-cron.
# GESTIONAR_BATCH_CRON=*/15 * * * *

# Supabase (service role + anon para verificar JWT en rutas admin)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Resend (emails de pedidos)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: para testear, enviar TODO a este email
RESEND_TEST_TO_EMAIL=
# Email del dueño que recibe la notificación de "nueva venta" cuando se confirma un pago.
# Si está vacío, no se manda nada (solo un warn en logs).
ADMIN_NOTIFICATION_EMAIL=

# Nave (pagos)
# Entorno: testing o production
NAVE_ENV=testing
NAVE_CLIENT_ID=
NAVE_CLIENT_SECRET=
# Requerido por documentación Nave M2M (ej. https://naranja.com/ranty/merchants/api)
NAVE_AUDIENCE=
NAVE_CACHE=
# POS ID proporcionado por Nave/Galicia
NAVE_POS_ID=
# Opcional: duration_time al crear la intención (Nave: segundos). Default en código: 600 (10 min).
# Para no enviar el campo (default del servidor Nave): NAVE_PAYMENT_DURATION_SECS=omit
# NAVE_PAYMENT_DURATION_SECS=

# Mercado Pago (Orders API + webhooks)
# Access token: Tus integraciones → Pruebas → Credenciales de prueba
MP_ACCESS_TOKEN=
# Clave secreta de notificaciones (Webhooks en el panel de la app)
MP_WEBHOOK_SECRET=

# Meta Conversions API (CAPI) — evento Purchase server-side.
# Sin estas dos variables el evento Purchase server-side NO se envía.
# META_PIXEL_ID:   ID numérico del pixel (Events Manager). Ej: 1982545185676457
# META_CAPI_TOKEN: token de Conversions API (Events Manager → Configuración → Generar token)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: código de Test Events para depurar en Events Manager → Probar eventos.
# Dejar vacío en producción.
META_TEST_EVENT_CODE=
